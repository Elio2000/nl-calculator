{
  "$comment": "词表是数据，文法是代码（见 parser.ts）。新增一种说法通常只需在这里加一行。分词按词条长度降序做最长匹配，因此 '除以' 必然先于 '除'、'次方根' 先于 '次方' 命中，无需额外排序逻辑。",

  "$fillerNote": "只剥多字短语与句末虚词。单独的「等于」不在此列——它在方程里是关系符（x平方加一等于零），剥掉就没法解方程了。问句尾「等于几/等于多少」是完整短语，先于它命中。",
  "fillers": [
    "请问", "请帮我", "帮我", "麻烦", "请", "算一下", "算算", "计算一下", "计算",
    "求一下", "结果是", "答案是", "的结果", "结果", "等于几", "等于多少",
    "是多少", "得多少", "多少", "几", "呢", "吧", "啊", "呀", "嘛", "?", "？", "。", "，", ",", " "
  ],

  "$intentNote": "方程与微积分的意图词，出现即改走 nerdamer 求解通道。",
  "intents": {
    "解方程": "SOLVE", "求解方程": "SOLVE", "解一下方程": "SOLVE",
    "$solveSuffixNote": "「…等于零的解」这类句尾意图词要连「的」一起收，否则「的」会悬在方程右侧解析不了",
    "的解": "SOLVE", "的根": "SOLVE", "的答案": "SOLVE", "解": "SOLVE",
    "求导": "DIFF", "的导数": "DIFF", "导数": "DIFF",
    "求积分": "INTEGRATE", "积分": "INTEGRATE", "不定积分": "INTEGRATE"
  },

  "variables": ["x", "y", "z", "X", "Y", "Z", "未知数"],

  "operators": {
    "加上": "+", "加": "+", "累加": "+",
    "减去": "-", "减掉": "-", "减": "-",
    "乘以": "*", "乘上": "*", "乘": "*", "×": "*",
    "除以": "/", "÷": "/",
    "取余": "mod", "取模": "mod", "模": "mod",
    "+": "+", "-": "-", "*": "*", "/": "/"
  },

  "ambiguousOperators": {
    "$comment": "裸『除』在数学上是 B/A，口语里常被当成 A/B。不猜，两种都生成候选交给用户选。",
    "除": ["/", "\\"]
  },

